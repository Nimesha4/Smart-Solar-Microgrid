<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/brand_bg">

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/brand_forest" android:gravity="center_vertical"
        android:padding="14dp">
        <TextView android:id="@+id/tvWelcome" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Grid Operator" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/brand_white" />
        <Button android:id="@+id/btnScanQr" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="8dp"
            android:text="Scan QR" android:backgroundTint="@color/brand_amber"
            android:textColor="@color/brand_white" />
        <Button android:id="@+id/btnLogout" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Logout"
            android:backgroundTint="@color/brand_white"
            android:textColor="@color/brand_forest" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp">
        <Button android:id="@+id/btnTabHubs" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:text="Hubs"
            android:backgroundTint="@color/brand_amber"
            android:textColor="@color/brand_white" />
        <Button android:id="@+id/btnTabReservations" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="5dp" android:text="Reservations"
            android:backgroundTint="@color/chip_grey_bg"
            android:textColor="@color/brand_ink" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout android:id="@+id/panelHubs" android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Microgrid Hubs" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/brand_forest"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/containerHubs" android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout android:id="@+id/panelReservations" android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone">
                <TextView android:text="Reservations" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/brand_forest"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/containerReservations"
                    android:orientation="vertical" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>