<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="@color/brand_bg">

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/brand_forest" android:gravity="center_vertical"
        android:padding="14dp">
        <TextView android:id="@+id/tvWelcome" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Welcome" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/brand_white" />
        <Button android:id="@+id/btnLogout" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Logout"
            android:backgroundTint="@color/brand_white"
            android:textColor="@color/brand_forest" />
    </LinearLayout>

    <LinearLayout android:orientation="horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="10dp">
        <Button android:id="@+id/btnTabReserve" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:text="Reserve"
            android:backgroundTint="@color/brand_amber"
            android:textColor="@color/brand_white" />
        <Button android:id="@+id/btnTabBookings" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="5dp" android:text="My Bookings"
            android:backgroundTint="@color/chip_grey_bg"
            android:textColor="@color/brand_ink" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:orientation="vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- RESERVE PANEL -->
            <LinearLayout android:id="@+id/panelReserve" android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Select Microgrid Node" android:textStyle="bold"
                    android:textColor="@color/brand_ink" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Spinner android:id="@+id/spinnerNodes" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" />

                <TextView android:text="Energy Amount (kWh)" android:textStyle="bold"
                    android:textColor="@color/brand_ink" android:layout_marginTop="16dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etEnergy" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="numberDecimal"
                    android:hint="e.g. 12.5" />

                <TextView android:text="Scheduled Date &amp; Time (max 7 days ahead)"
                    android:textStyle="bold" android:textColor="@color/brand_ink"
                    android:layout_marginTop="16dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnPickDate" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:backgroundTint="@color/brand_green"
                    android:textColor="@color/brand_white" android:text="Pick date &amp; time" />
                <TextView android:id="@+id/tvDateChosen" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="No date selected" android:textColor="@color/brand_muted" />

                <Button android:id="@+id/btnCreate" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="@color/brand_forest"
                    android:textColor="@color/brand_white" android:text="Create Booking" />
                <TextView android:id="@+id/tvReserveMsg" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="@color/brand_red" />
            </LinearLayout>

            <!-- BOOKINGS PANEL -->
            <LinearLayout android:id="@+id/panelBookings" android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone">
                <TextView android:text="My Bookings" android:textSize="18sp"
                    android:textStyle="bold" android:textColor="@color/brand_forest"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvBookingsEmpty" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="No bookings yet." android:textColor="@color/brand_muted" />
                <LinearLayout android:id="@+id/containerBookings" android:orientation="vertical"
                    android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>