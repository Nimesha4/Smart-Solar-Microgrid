<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/brand_bg">

    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_horizontal" android:padding="28dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="☀" android:textSize="52sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Smart Solar Microgrid" android:textSize="24sp"
            android:textStyle="bold" android:textColor="@color/brand_forest" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Peer-to-peer solar energy trading" android:textSize="13sp"
            android:textColor="@color/brand_muted" android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="16dp" app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout android:orientation="vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sign in" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@color/brand_ink" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NIC Number" android:layout_marginTop="16dp"
                    android:textColor="@color/brand_muted" />
                <EditText android:id="@+id/etNic" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="text"
                    android:hint="e.g. 199512345678" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Password" android:layout_marginTop="12dp"
                    android:textColor="@color/brand_muted" />
                <EditText android:id="@+id/etPassword" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:inputType="textPassword"
                    android:hint="••••••" />

                <Button android:id="@+id/btnLogin" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:backgroundTint="@color/brand_forest"
                    android:textColor="@color/brand_white" android:text="Sign In" />

                <TextView android:id="@+id/tvRegister" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="14dp"
                    android:gravity="center" android:text="New prosumer? Register here"
                    android:textColor="@color/brand_green" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>